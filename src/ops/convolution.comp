    {
        if (p.op != 0)
        {
            float value = gradient(i);
            if (nanBits(value) || nanBits(p.alpha)) { result = uintBitsToFloat(0x7fc00000u); }
            else
            {
                result = value * p.alpha;
            }
        }
        else
        {
            uint ox = i % p.ow, oy = (i / p.ow) % p.oh;
            uint oc = (i / (p.ow * p.oh)) % p.k;
            uint batch = i / (p.ow * p.oh * p.k);
            uint first = (oc / (p.k / p.groups)) * p.fc;
            bool bad = false;
            for (uint ic = 0; ic < p.fc; ++ic)
            {
                for (uint ky = 0; ky < p.kh; ++ky)
                {
                    int iy = int(oy * p.sh + ky * p.dh) - int(p.ph);
                    if (iy < 0 || iy >= int(p.h)) { continue; }
                    for (uint kx = 0; kx < p.kw; ++kx)
                    {
                        int ix = int(ox * p.sw + kx * p.dw) - int(p.pw);
                        if (ix < 0 || ix >= int(p.w)) { continue; }
                        uint wy = ky, wx = kx;
                        if (p.mode == 0)
                        {
                            wy = p.kh - 1 - ky;
                            wx = p.kw - 1 - kx;
                        }
                        float a = x[p.aOffset + ((batch * p.c + first + ic) * p.h + uint(iy)) * p.w + uint(ix)];
                        float b = w[p.bOffset + ((oc * p.fc + ic) * p.kh + wy) * p.kw + wx];
                        float product = a * b;
                        bad = bad || nanBits(a) || nanBits(b) || nanBits(product);
                        result += product;
                        bad = bad || nanBits(result);

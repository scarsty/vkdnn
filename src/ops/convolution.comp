    {
        uint xx = i % p.ow, yy = (i / p.ow) % p.oh;
        uint cc = (i / (p.ow * p.oh)) % p.k, nn = i / (p.ow * p.oh * p.k);
        if (p.w == 1) { xx = 0; }
        if (p.h == 1) { yy = 0; }
        if (p.c == 1) { cc = 0; }
        if (p.n == 1) { nn = 0; }
        float a = 0.0, b = 0.0;
        if (p.gamma != 0.0) { a = product(p.gamma, x[p.aOffset + i]); }
        if (p.delta != 0.0) { b = product(p.delta, w[p.bOffset + ((nn * p.c + cc) * p.h + yy) * p.w + xx]); }
        if (p.nan == 0)

#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer Weights { float w[]; };
layout(set = 0, binding = 2, std430) buffer Output { float y[]; };
layout(push_constant) uniform Params
{
    uint count, c, h, w, k, fc, kh, kw, oh, ow;
    uint ph, pw, sh, sw, dh, dw, groups, mode;
    uint aOffset, bOffset, cOffset;
    float alpha, beta;
}
p;
bool nanBits(float v) { return (floatBitsToUint(v) & 0x7fffffffu) > 0x7f800000u; }
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.count) { return; }
    float result = 0.0;
    if (p.alpha != 0.0)
    {
        uint ox = i % p.ow, oy = (i / p.ow) % p.oh;
        uint oc = (i / (p.ow * p.oh)) % p.k;
        uint batch = i / (p.ow * p.oh * p.k);
        uint first = (oc / (p.k / p.groups)) * p.fc;
        bool bad = false;
        for (uint ic = 0; ic < p.fc; ++ic)
        {
            for (uint ky = 0; ky < p.kh; ++ky)
            {
                int iy = int(oy * p.sh + ky * p.dh) - int(p.ph);
                if (iy < 0 || iy >= int(p.h)) { continue; }
                for (uint kx = 0; kx < p.kw; ++kx)
                {
                    int ix = int(ox * p.sw + kx * p.dw) - int(p.pw);
                    if (ix < 0 || ix >= int(p.w)) { continue; }
                    uint wy = ky, wx = kx;
                    if (p.mode == 0)
                    {
                        wy = p.kh - 1 - ky;
                        wx = p.kw - 1 - kx;
                    }
                    float a = x[p.aOffset + ((batch * p.c + first + ic) * p.h + uint(iy)) * p.w + uint(ix)];
                    float b = w[p.bOffset + ((oc * p.fc + ic) * p.kh + wy) * p.kw + wx];
                    float product = a * b;
                    bad = bad || nanBits(a) || nanBits(b) || nanBits(product);
                    result += product;
                    bad = bad || nanBits(result);
                }
            }
        }
        result *= p.alpha;
        if (bad || nanBits(p.alpha)) { result = uintBitsToFloat(0x7fc00000u); }
    }
    if (p.beta != 0.0)
    {
        float old = y[p.cOffset + i];
        if (nanBits(old) || nanBits(p.beta) || nanBits(result)) { result = uintBitsToFloat(0x7fc00000u); }
        else
        {
            result += p.beta * old;
        }
    }
    y[p.cOffset + i] = result;
}

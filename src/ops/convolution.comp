                                wx = p.kw - 1 - kx;
                            }
                            float a = x[p.aOffset + ((batch * p.c + first + ic) * p.h + uint(iy)) * p.w + uint(ix)];
                            float b = w[p.bOffset + ((oc * p.fc + ic) * p.kh + wy) * p.kw + wx];
                            float product = a * b;
                            bad = bad || nanBits(a) || nanBits(b) || nanBits(product);
                            result += product;
                            bad = bad || nanBits(result);
                        }
                    }
                }
            }
            result *= p.alpha;
            if (bad || nanBits(p.alpha)) { result = uintBitsToFloat(0x7fc00000u); }
        }
    }
    if (nanBits(p.alpha) || nanBits(p.beta) || nanBits(result)) { result = uintBitsToFloat(0x7fc00000u); }
    if (p.beta != 0.0)
    {
        float old = y[p.cOffset + i];
        if (nanBits(old) || nanBits(p.beta) || nanBits(result)) { result = uintBitsToFloat(0x7fc00000u); }
        else
        {
            result += p.beta * old;
        }
    }
    y[p.cOffset + i] = result;
}
#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer Weights { float w[]; };
layout(set = 0, binding = 2, std430) buffer Output { float y[]; };
layout(push_constant) uniform Params
{
    uint count, c, h, w, k, fc, kh, kw, oh, ow;
    uint ph, pw, sh, sw, dh, dw, groups, mode;
    uint aOffset, bOffset, cOffset;
    float alpha, beta;
    uint op, n, nan;
    float gamma, delta;
}
p;
bool nanBits(float v) { return (floatBitsToUint(v) & 0x7fffffffu) > 0x7f800000u; }
float product(float a, float b)
{
    if (nanBits(a) || nanBits(b)) { return uintBitsToFloat(0x7fc00000u); }
    return a * b;
}
float gradient(uint i)
{
    float sum = 0.0;

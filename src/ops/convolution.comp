            if (nanBits(b)) { b = 0.0; }
        }
        if (nanBits(a) || nanBits(b)) { return uintBitsToFloat(0x7fc00000u); }
        if (p.mode == 1) { return product(a, b); }
        return a + b;
    }
    if (p.op == 6)
    {
        uint spatial = p.h * p.w, length = p.c * spatial, stride = 1;
        uint base = (i / length) * length;
        if (p.mode == 1)
        {
            length = p.c;
            stride = spatial;
            base = (i / (spatial * p.c)) * spatial * p.c + i % spatial;
        }
        for (uint j = 0; j < length; ++j)
        {
            float d = w[p.bOffset + base + j * stride];
            if (p.nan == 2) { sum += d; }
            else
            {
                sum += product(x[p.aOffset + base + j * stride], d);
            }
        }
        float value = x[p.aOffset + i], dy = w[p.bOffset + i];
        if (nanBits(sum) || nanBits(value) || nanBits(dy)) { return uintBitsToFloat(0x7fc00000u); }
        if (p.nan == 2) { return dy - exp(value) * sum; }
        return product(value, dy - sum);
    }
    if (p.op == 3)
    {
        for (uint bn = 0; bn < p.n; ++bn)
        {
            for (uint s = 0; s < p.oh * p.ow; ++s)
            {
                sum += x[p.aOffset + (bn * p.k + i) * p.oh * p.ow + s];
            }
        }
        return sum;
    }
    if (p.op == 4)
    {
        uint ix = i % p.w, iy = (i / p.w) % p.h, nc = i / (p.h * p.w);
        uint firstY = 0, firstX = 0;
        if (iy + p.ph >= p.kh) { firstY = (iy + p.ph - p.kh) / p.sh + 1; }
        if (ix + p.pw >= p.kw) { firstX = (ix + p.pw - p.kw) / p.sw + 1; }
        for (uint oy = firstY; oy < p.oh && oy <= (iy + p.ph) / p.sh; ++oy)
        {
            for (uint ox = firstX; ox < p.ow && ox <= (ix + p.pw) / p.sw; ++ox)
            {
                int top = int(oy * p.sh) - int(p.ph), left = int(ox * p.sw) - int(p.pw);
                uint valid = 0, winner = 0xffffffffu;
                float best = uintBitsToFloat(0xff800000u);
                bool bad = false;
                for (uint a = uint(max(0, -top)); a < p.kh && a < uint(int(p.h) - top); ++a)
                {
                    for (uint b = uint(max(0, -left)); b < p.kw && b < uint(int(p.w) - left); ++b)
                    {
                        int yy = top + int(a), xx = left + int(b);
                        if (yy < 0 || xx < 0 || yy >= int(p.h) || xx >= int(p.w)) { continue; }
                        ++valid;
                        uint j = nc * p.h * p.w + uint(yy) * p.w + uint(xx);
                        float v = x[p.aOffset + j];
                        if (nanBits(v))
                        {
                            bad = bad || p.nan == 1;
                            continue;
                        }
                        if (winner == 0xffffffffu || v > best)
                        {
                            best = v;
                            winner = j;
                        }
                    }
                }
                if (bad) { return uintBitsToFloat(0x7fc00000u); }
                float d = w[p.bOffset + (nc * p.oh + oy) * p.ow + ox];
                if (p.mode == 0)
                {
                    if (winner == i) { sum += d; }
                }
                else if (!nanBits(x[p.aOffset + i]))
                {
                    uint divisor = valid;
                    if (p.mode == 1) { divisor = p.kh * p.kw; }
                    sum += d / float(divisor);
                }
            }
        }
        return sum;
    }
    if (p.op == 1)
    {
        uint ix = i % p.w, iy = (i / p.w) % p.h;
        uint ic = (i / (p.h * p.w)) % p.c, bn = i / (p.h * p.w * p.c);
        uint group = ic / p.fc, kg = p.k / p.groups;
        for (uint oc = group * kg; oc < (group + 1) * kg; ++oc)
        {
            for (uint fy = 0; fy < p.kh; ++fy)
            {
                for (uint fx = 0; fx < p.kw; ++fx)
                {
                    uint ky = fy, kx = fx;
                    if (p.mode == 0)
                    {
                        ky = p.kh - 1 - fy;
                        kx = p.kw - 1 - fx;
                    }
                    int yy = int(iy + p.ph) - int(ky * p.dh), xx = int(ix + p.pw) - int(kx * p.dw);
                    if (yy < 0 || xx < 0 || yy % int(p.sh) != 0 || xx % int(p.sw) != 0) { continue; }
                    uint oy = uint(yy) / p.sh, ox = uint(xx) / p.sw;
                    if (oy >= p.oh || ox >= p.ow) { continue; }
                    sum += product(x[p.aOffset + ((oc * p.fc + ic % p.fc) * p.kh + fy) * p.kw + fx],
                                   w[p.bOffset + ((bn * p.k + oc) * p.oh + oy) * p.ow + ox]);
                }
            }
        }
        return sum;
    }
    uint fx = i % p.kw, fy = (i / p.kw) % p.kh;
    uint ic = (i / (p.kh * p.kw)) % p.fc, oc = i / (p.kh * p.kw * p.fc);
    uint ky = fy, kx = fx;
    if (p.mode == 0)
    {
        ky = p.kh - 1 - fy;
        kx = p.kw - 1 - fx;
    }
    uint channel = oc / (p.k / p.groups) * p.fc + ic;
    for (uint bn = 0; bn < p.n; ++bn)
    {
        for (uint oy = 0; oy < p.oh; ++oy)
        {
            for (uint ox = 0; ox < p.ow; ++ox)
            {
                int iy = int(oy * p.sh + ky * p.dh) - int(p.ph), ix = int(ox * p.sw + kx * p.dw) - int(p.pw);
                if (iy < 0 || ix < 0 || iy >= int(p.h) || ix >= int(p.w)) { continue; }
                sum += product(x[p.aOffset + ((bn * p.c + channel) * p.h + uint(iy)) * p.w + uint(ix)],
                               w[p.bOffset + ((bn * p.k + oc) * p.oh + oy) * p.ow + ox]);
            }
        }
    }
    return sum;
}
void main()
{

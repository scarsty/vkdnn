#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float x[]; };
layout(set = 0, binding = 1, std430) buffer Output { float y[]; };
layout(push_constant) uniform Params
{
    uint op, count, n, c, h, w, oh, ow, kh, kw, ph, pw, sh, sw, mode, nan;
    float alpha, beta;
    uint xOffset, yOffset;
    uint outputC;
}
p;
shared float reduction[64];
shared uint invalid[64];
float loadX(uint i) { return x[p.xOffset + i]; }
bool isNanBits(float v) { return (floatBitsToUint(v) & 0x7fffffffu) > 0x7f800000u; }
void storeY(uint i, float v)
{
    if (isNanBits(v))
    {
        y[p.yOffset + i] = uintBitsToFloat(0x7fc00000u);
        return;
    }
    if (isNanBits(p.alpha) || isNanBits(p.beta))
    {
        y[p.yOffset + i] = uintBitsToFloat(0x7fc00000u);
        return;
    }
    if (p.beta != 0.0 && isNanBits(y[p.yOffset + i]))
    {
        y[p.yOffset + i] = uintBitsToFloat(0x7fc00000u);
        return;
    }
    float r = p.alpha * v;
    if (p.beta != 0.0)
    {
        r += p.beta * y[p.yOffset + i];
    }
    y[p.yOffset + i] = r;
}
void softmax()
{
    uint group = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    if (group >= p.count) { return; }
    uint lane = gl_LocalInvocationID.x;
    uint spatial = p.h * p.w;
    uint length = p.c * spatial, stride = 1, base = group * length;
    if (p.mode == 1)
    {
        length = p.c;
        stride = spatial;
        base = (group / spatial) * p.c * spatial + group % spatial;
    }
    float m = uintBitsToFloat(0xff800000u);
    uint bad = 0;
    for (uint j = lane; j < length; j += 64)
    {
        float t = loadX(base + j * stride);
        if (isNanBits(t)) { bad = 1; }
        else
        {
            m = max(m, t);
        }
    }
    reduction[lane] = m;
    invalid[lane] = bad;
    barrier();
    for (uint step = 32; step > 0; step >>= 1)
    {
        if (lane < step)
        {
            reduction[lane] = max(reduction[lane], reduction[lane + step]);
            invalid[lane] |= invalid[lane + step];
        }
        barrier();
    }
    m = reduction[0];
    bad = invalid[0];
    if (isinf(m)) { bad = 1; }
    // Every lane has captured the maximum before shared storage is reused.
    barrier();
    float sum = 0.0;
    for (uint j = lane; j < length; j += 64)
    {
        sum += exp(loadX(base + j * stride) - m);
    }
    reduction[lane] = sum;
    barrier();
    for (uint step = 32; step > 0; step >>= 1)
    {
        if (lane < step) { reduction[lane] += reduction[lane + step]; }
        barrier();
    }
    sum = reduction[0];
    for (uint j = lane; j < length; j += 64)
    {
        float z = loadX(base + j * stride) - m;
        float v = exp(z) / sum;
        if (p.op == 3) { v = z - log(sum); }
        if (bad != 0) { v = uintBitsToFloat(0x7fc00000u); }
        storeY(base + j * stride, v);
    }
}
void activation(uint i)
{
    if (p.alpha == 0.0)
    {
        storeY(i, 0.0);
        return;
    }
    float v = loadX(i);
    if (p.mode == 0 || p.mode == 2)
    {
        if (isNanBits(v))
        {
            storeY(i, uintBitsToFloat(0x7fc00000u));
            return;
        }
        if (p.mode == 2)
        {
            if (abs(v) < 0.0001) { storeY(i, v); }
            else
            {
                float e = exp(-2.0 * min(abs(v), 80.0));
                float t = (1.0 - e) / (1.0 + e);
                if (v < 0.0) { t = -t; }
                storeY(i, t);
            }
            return;
        }
        float e = exp(-abs(v));
        if (v >= 0.0) { v = 1.0 / (1.0 + e); }
        else
        {
            v = e / (1.0 + e);
        }
        storeY(i, v);
        return;
    }
    bool bad = isNanBits(v) && p.nan == 1;
    if (isNanBits(v)) { v = 0.0; }
    v = max(v, 0.0);
    if (bad) { v = uintBitsToFloat(0x7fc00000u); }
    storeY(i, v);
}
void main()
{
    if (p.op == 2 || p.op == 3)
    {
        softmax();
        return;
    }
    uint i = gl_GlobalInvocationID.x;
    if (p.op == 0)
    {
        i *= 4;
        if (i >= p.count) { return; }
        if (p.count - i < 4 || p.alpha == 0.0)
        {
            for (uint k = 0; k < 4 && i + k < p.count; ++k) { activation(i + k); }
            return;
        }
        vec4 v = vec4(loadX(i), loadX(i + 1), loadX(i + 2), loadX(i + 3));
        vec4 r;
        if (p.mode == 0)
        {
            vec4 e = exp(-abs(v));
            r = mix(e / (1.0 + e), 1.0 / (1.0 + e), greaterThanEqual(v, vec4(0.0)));
        }
        else if (p.mode == 2)
        {
            vec4 e = exp(-2.0 * min(abs(v), vec4(80.0)));
            r = sign(v) * (1.0 - e) / (1.0 + e);
            r = mix(r, v, lessThan(abs(v), vec4(0.0001)));
        }
        else
        {
            r = max(v, vec4(0.0));
        }
        for (uint k = 0; k < 4; ++k)
        {
            if (isNanBits(v[k]))
            {
                r[k] = uintBitsToFloat(0x7fc00000u);
                if (p.mode == 1 && p.nan == 0) { r[k] = 0.0; }
            }
            storeY(i + k, r[k]);
        }
        return;
    }
    if (i >= p.count) { return; }
    if (p.op == 5)
    {
        y[p.yOffset + i] = p.alpha;
    }
    else if (p.op == 4)
    {
        if (p.alpha == 0.0)
        {
            storeY(i, 0.0);
            return;
        }
        uint xx = i % p.ow, yy = (i / p.ow) % p.oh;
        uint cc = (i / (p.ow * p.oh)) % p.outputC;
        uint nn = i / (p.ow * p.oh * p.outputC);
        if (p.w == 1) { xx = 0; }
        if (p.h == 1) { yy = 0; }
        if (p.c == 1) { cc = 0; }
        if (p.n == 1) { nn = 0; }
        storeY(i, loadX(((nn * p.c + cc) * p.h + yy) * p.w + xx));
    }
    else if (p.op == 1)
    {
        uint ox = i % p.ow, oy = (i / p.ow) % p.oh, nc = i / (p.ow * p.oh);
        int top = int(oy * p.sh) - int(p.ph), left = int(ox * p.sw) - int(p.pw);
        float v = 0.0;
        if (p.mode == 0)
        {
            v = uintBitsToFloat(0xff800000u);
        }
        uint valid = 0;
        bool bad = false;
        for (uint a = 0; a < p.kh; ++a)
        {
            for (uint b = 0; b < p.kw; ++b)
            {
                int yy = top + int(a), xx = left + int(b);
                if (yy < 0 || xx < 0 || yy >= int(p.h) || xx >= int(p.w))
                {
                    continue;
                }
                ++valid;
                float t = loadX(nc * p.h * p.w + uint(yy) * p.w + uint(xx));
                if (isNanBits(t))
                {
                    if (p.nan == 1)
                    {
                        bad = true;
                    }
                    continue;
                }
                if (p.mode == 0)
                {
                    v = max(v, t);
                }
                else
                {
                    v += t;
                }
            }
        }
        if (p.mode == 1)
        {
            v /= float(p.kh * p.kw);
        }
        if (p.mode == 2)
        {
            v /= float(valid);
        }
        if (bad)
        {
            v = uintBitsToFloat(0x7fc00000u);
        }
        storeY(i, v);
    }
}

#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float x[]; };
layout(set = 0, binding = 1, std430) buffer Output { float y[]; };
layout(push_constant) uniform Params
{
    uint op, count, n, c, h, w, oh, ow, kh, kw, ph, pw, sh, sw, mode, nan;
    float alpha, beta;
    uint xOffset, yOffset;
    uint outputC;
}
p;
float loadX(uint i) { return x[p.xOffset + i]; }
bool isNanBits(float v) { return (floatBitsToUint(v) & 0x7fffffffu) > 0x7f800000u; }
void storeY(uint i, float v)
{
    if (isNanBits(v))
    {
        y[p.yOffset + i] = uintBitsToFloat(0x7fc00000u);
        return;
    }
    if (isNanBits(p.alpha) || isNanBits(p.beta))
    {
        y[p.yOffset + i] = uintBitsToFloat(0x7fc00000u);
        return;
    }
    if (p.beta != 0.0 && isNanBits(y[p.yOffset + i]))
    {
        y[p.yOffset + i] = uintBitsToFloat(0x7fc00000u);
        return;
    }
    float r = p.alpha * v;
    if (p.beta != 0.0)
    {
        r += p.beta * y[p.yOffset + i];
    }
    y[p.yOffset + i] = r;
}
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.count)
    {
        return;
    }
    if (p.op == 0)
    {
        if (p.alpha == 0.0)
        {
            storeY(i, 0.0);
            return;
        }
        float v = loadX(i);
        if (p.mode == 0 || p.mode == 2)
        {
            if (isNanBits(v))
            {
                storeY(i, uintBitsToFloat(0x7fc00000u));
                return;
            }
            if (p.mode == 2)
            {
                // Avoid overflowing exp for large values and preserve accuracy near zero.
                if (abs(v) < 0.0001) { storeY(i, v); }
                else
                {
                    float e = exp(-2.0 * min(abs(v), 80.0));
                    float t = (1.0 - e) / (1.0 + e);
                    if (v < 0.0) { t = -t; }
                    storeY(i, t);
                }
                return;
            }
            float e = exp(-abs(v));
            if (v >= 0.0) { v = 1.0 / (1.0 + e); }
            else
            {
                v = e / (1.0 + e);
            }
            storeY(i, v);
            return;
        }
        bool bad = isNanBits(v) && p.nan == 1;
        if (isNanBits(v))
        {
            v = 0.0;
        }
        v = max(v, 0.0);
        if (bad)
        {
            v = uintBitsToFloat(0x7fc00000u);
        }
        storeY(i, v);
    }
    else if (p.op == 4)
    {
        if (p.alpha == 0.0)
        {
            storeY(i, 0.0);
            return;
        }
        uint xx = i % p.ow, yy = (i / p.ow) % p.oh;
        uint cc = (i / (p.ow * p.oh)) % p.outputC;
        uint nn = i / (p.ow * p.oh * p.outputC);
        if (p.w == 1) { xx = 0; }
        if (p.h == 1) { yy = 0; }
        if (p.c == 1) { cc = 0; }
        if (p.n == 1) { nn = 0; }
        storeY(i, loadX(((nn * p.c + cc) * p.h + yy) * p.w + xx));
    }
    else if (p.op == 1)
    {
        uint ox = i % p.ow, oy = (i / p.ow) % p.oh, nc = i / (p.ow * p.oh);
        int top = int(oy * p.sh) - int(p.ph), left = int(ox * p.sw) - int(p.pw);
        float v = 0.0;
        if (p.mode == 0)
        {
            v = uintBitsToFloat(0xff800000u);
        }
        uint valid = 0;
        bool bad = false;
        for (uint a = 0; a < p.kh; ++a)
        {
            for (uint b = 0; b < p.kw; ++b)
            {
                int yy = top + int(a), xx = left + int(b);
                if (yy < 0 || xx < 0 || yy >= int(p.h) || xx >= int(p.w))
                {
                    continue;
                }
                ++valid;
                float t = loadX(nc * p.h * p.w + uint(yy) * p.w + uint(xx));
                if (isNanBits(t))
                {
                    if (p.nan == 1)
                    {
                        bad = true;
                    }
                    continue;
                }
                if (p.mode == 0)
                {
                    v = max(v, t);
                }
                else
                {
                    v += t;
                }
            }
        }
        if (p.mode == 1)
        {
            v /= float(p.kh * p.kw);
        }
        if (p.mode == 2)
        {
            v /= float(valid);
        }
        if (bad)
        {
            v = uintBitsToFloat(0x7fc00000u);
        }
        storeY(i, v);
    }
    else
    {
        uint spatial = p.h * p.w;
        uint length = p.c * spatial, stride = 1, base = i * length;
        if (p.mode == 1)
        {
            length = p.c;
            stride = spatial;
            base = (i / spatial) * p.c * spatial + i % spatial;
        }
        float m = uintBitsToFloat(0xff800000u);
        bool bad = false;
        for (uint j = 0; j < length; ++j)
        {
            float t = loadX(base + j * stride);
            bad = bad || isNanBits(t);
            m = max(m, t);
        }
        bad = bad || isinf(m);
        float sum = 0.0;
        for (uint j = 0; j < length; ++j)
        {
            sum += exp(loadX(base + j * stride) - m);
        }
        for (uint j = 0; j < length; ++j)
        {
            float z = loadX(base + j * stride) - m;
            float v = exp(z) / sum;
            if (p.op == 3)
            {
                v = z - log(sum);
            }
            if (bad)
            {
                v = uintBitsToFloat(0x7fc00000u);
            }
            storeY(base + j * stride, v);
        }
    }
}

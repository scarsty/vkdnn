#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer Activated { float y[]; };
layout(set = 0, binding = 2, std430) readonly buffer Gradient { float dy[]; };
layout(set = 0, binding = 3, std430) buffer Output { float dx[]; };
layout(push_constant) uniform Params
{
    uint count, mode, nan, xOffset, yOffset, dyOffset, dxOffset;
    float alpha, beta;
}
p;
bool isNanBits(float v) { return (floatBitsToUint(v) & 0x7fffffffu) > 0x7f800000u; }
void scalar(uint i)
{
    if (i >= p.count) { return; }
    float result = 0.0;
    bool bad = isNanBits(p.alpha) || isNanBits(p.beta);
    if (p.alpha != 0.0)
    {
        float gradient = dy[p.dyOffset + i];
        float derivative = 0.0;
        bad = bad || isNanBits(gradient);
        if (p.mode == 1)
        {
            float v = x[p.xOffset + i];
            bad = bad || (isNanBits(v) && p.nan == 1);
            if (!isNanBits(v) && v > 0.0) { derivative = 1.0; }
        }
        else
        {
            float v = y[p.yOffset + i];
            bad = bad || isNanBits(v);
            if (p.mode == 0) { derivative = v * (1.0 - v); }
            else
            {
                derivative = 1.0 - v * v;
            }
        }
        result = p.alpha * (gradient * derivative);
    }
    if (p.beta != 0.0)
    {
        float prior = dx[p.dxOffset + i];
        bad = bad || isNanBits(prior);
        result += p.beta * prior;
    }
    if (bad) { result = uintBitsToFloat(0x7fc00000u); }
    dx[p.dxOffset + i] = result;
}
void main()
{
    uint i = gl_GlobalInvocationID.x * 4;
    if (i >= p.count) { return; }
    if (p.count - i < 4)
    {
        for (uint j = i; j < p.count; ++j) { scalar(j); }
        return;
    }
    vec4 result = vec4(0.0);
    bvec4 bad = bvec4(isNanBits(p.alpha) || isNanBits(p.beta));
    if (p.alpha != 0.0)
    {
        vec4 d = vec4(dy[p.dyOffset + i], dy[p.dyOffset + i + 1], dy[p.dyOffset + i + 2], dy[p.dyOffset + i + 3]);
        vec4 v;
        if (p.mode == 1) { v = vec4(x[p.xOffset + i], x[p.xOffset + i + 1], x[p.xOffset + i + 2], x[p.xOffset + i + 3]); }
        else
        {
            v = vec4(y[p.yOffset + i], y[p.yOffset + i + 1], y[p.yOffset + i + 2], y[p.yOffset + i + 3]);
        }
        vec4 derivative;
        if (p.mode == 1) { derivative = mix(vec4(0.0), vec4(1.0), greaterThan(v, vec4(0.0))); }
        else if (p.mode == 0) { derivative = v * (vec4(1.0) - v); }
        else
        {
            derivative = vec4(1.0) - v * v;
        }
        for (int j = 0; j < 4; ++j)
        {
            bad[j] = bad[j] || isNanBits(d[j]) || (isNanBits(v[j]) && (p.mode != 1 || p.nan == 1));
        }
        result = p.alpha * (d * derivative);
    }
    if (p.beta != 0.0)
    {
        vec4 old = vec4(dx[p.dxOffset + i], dx[p.dxOffset + i + 1], dx[p.dxOffset + i + 2], dx[p.dxOffset + i + 3]);
        for (int j = 0; j < 4; ++j) { bad[j] = bad[j] || isNanBits(old[j]); }
        result += p.beta * old;
    }
    result = mix(result, vec4(uintBitsToFloat(0x7fc00000u)), bad);
    for (uint j = 0; j < 4; ++j) { dx[p.dxOffset + i + j] = result[j]; }
}
